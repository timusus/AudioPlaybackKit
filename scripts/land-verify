#!/usr/bin/env bash
#
# Verify command for `land` (see .claude/land.conf): build everything, run the macOS-slice tests, then compile the device suite.
# Prints only the `verify:` protocol; full tool output goes to $LAND_ARTIFACT_DIR.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 2
[ -t 0 ] || cat >/dev/null # changed paths on stdin; every phase always runs

artifacts="${LAND_ARTIFACT_DIR:-$(mktemp -d)}"
mkdir -p "$artifacts"
failed=0

# The build tool colours its output even when piped.
# shellcheck disable=SC2329
plain() { sed $'s/\x1b\\[[0-9;]*m//g' "$1"; }

# Compiler errors as `File.swift: message` so line numbers never make two trees differ.
# shellcheck disable=SC2329 # called by name from run_phase
compile_failures() {
    plain "$1" | sed -nE 's|^.*/([^/:]+):[0-9]+:[0-9]+: error: (.*)$|\1: \2|p' | sort -u
}

# XCTest `-[Module.Class testName]` becomes `Module.Class/testName`; swift-testing reports the display name.
# shellcheck disable=SC2329
test_failures() {
    {
        plain "$1" | sed -nE "s|^Test Case '-\[([^ ]+) ([^]]+)\]' failed.*|\1/\2|p"
        # --parallel prints no per-case verdict, only each assertion as `error: -[Module.Class test] : message`.
        plain "$1" | sed -nE 's|^.*: error: -\[([^ ]+) ([^]]+)\] : .*|\1/\2|p'
        # Drop the run summary and the per-case count of a parameterized test: both vary between trees.
        plain "$1" | sed -E -e '/✘ Test run with /d' -e 's|^.*✘ Test (.+) failed after .*|\1|p' -e 'd' \
            | sed -E 's/ with [0-9]+ test cases?$//'
    } | sort -u
}

run_phase() {
    local phase="$1" extractor="$2"
    shift 2
    local log="$artifacts/$phase.log" started=$SECONDS
    echo "verify: == $phase"
    # A stale .build would report another tree's failures.
    if [[ "$phase" == test && "$failed" -ne 0 ]]; then
        echo "verify: -- test failed: build failed"
        return
    fi
    if "$@" >"$log" 2>&1; then
        echo "verify:    $phase: $((SECONDS - started)) s"
        return
    fi
    failed=1
    local failures
    failures="$("$extractor" "$log")"
    if [[ -n "$failures" ]]; then
        while IFS= read -r line; do echo "verify: !! $line"; done <<<"$failures"
    fi
    echo "verify:    $phase: $((SECONDS - started)) s"
    echo "verify: -- $phase failed: see $log"
    tail -n 15 "$log" | sed 's/^/  | /' >&2
}

# base, bisect and confirm runs name the phases that failed; an empty list means all.
phase_wanted() { [[ -z "${LAND_PHASES:-}" || " $LAND_PHASES " == *" $1 "* ]]; }

# Runs just the LAND_ONLY tests, or every test when a name matches no single test: swift only warns on a filter
# that matches nothing, so the others would pass and clear a real failure.
# shellcheck disable=SC2329 # called by name from run_phase
run_confirm_tests() {
    local filters=() name escaped listed missing=0
    if [[ -z "${LAND_ONLY// /}" ]]; then
        echo "LAND_ONLY names no test"
        return 1
    fi
    # swift-testing prints display names, not ids, so the list is the only way to tell a name exists.
    listed="$(swift test list --skip-build 2>&1)" || { echo "$listed"; return 1; }
    local ids
    for name in $LAND_ONLY; do
        if ! grep -qxF -- "$name" <<<"$listed"; then
            # swift-testing failures are named by display name; map one to its id when exactly one test has it.
            ids="$(grep -F -- "/$name" <<<"$listed" | awk -v n="/$name" 'substr($0, length($0) - length(n) + 1) == n')"
            if [[ -z "$ids" || "$(wc -l <<<"$ids")" -ne 1 ]]; then
                # A rerun that skipped this test could clear or misblame its failure, so run them all.
                echo "cannot resolve $name to one test; running every test"
                swift test --skip-build --parallel --num-workers 4 2>&1
                return
            fi
            name="$ids"
        fi
        escaped="$(sed -E 's/[][\.*^$+?(){}|]/\\&/g' <<<"$name")"
        # A swift-testing id carries a source location after the `()`, so only XCTest ids can be end-anchored.
        if [[ "$name" == *')' ]]; then filters+=(--filter "^${escaped}"); else filters+=(--filter "^${escaped}\$"); fi
    done
    if [[ "${#filters[@]}" -gt 0 ]]; then
        swift test --skip-build --parallel --num-workers 4 "${filters[@]}" 2>&1 || missing=1
    fi
    return "$missing"
}

# The device suite is an xcodegen project `swift test` never compiles; its own derived data keeps the phone's intact.
# arm64 only: the committed FFmpeg xcframework has no x86_64 simulator slice.
# shellcheck disable=SC2329 # called by name from run_phase
build_device_suite() {
    command -v xcodegen >/dev/null || { echo "xcodegen: command not found"; return 1; }
    xcodegen generate --quiet --spec Tests/PlaybackDeviceTests/project.yml || return 1
    xcodebuild build-for-testing -project Tests/PlaybackDeviceTests/PlaybackDeviceTests.xcodeproj \
        -scheme PlaybackDeviceTests -destination 'generic/platform=iOS Simulator' \
        -derivedDataPath .build/device-tests/sim-dd CODE_SIGNING_ALLOWED=NO ARCHS=arm64 -quiet
}

if [[ "${LAND_MODE:-}" == confirm ]]; then
    [[ -n "${LAND_ONLY:-}" ]] || { echo "verify: -- LAND_ONLY is empty" >&2; exit 2; }
    phase_wanted test && run_phase test test_failures run_confirm_tests
else
    echo "verify: confirm"
    phase_wanted build && run_phase build compile_failures swift build --build-tests -j 5
    # base and bisect reruns (verify_failed_cmd) set LAND_ONLY without LAND_MODE and still need the build.
    if [[ -n "${LAND_ONLY:-}" ]]; then
        phase_wanted test && run_phase test test_failures run_confirm_tests
    else
        phase_wanted test && run_phase test test_failures swift test --skip-build --parallel --num-workers 4
    fi
    phase_wanted devbuild && run_phase devbuild compile_failures build_device_suite
fi

echo "verify: == end"
exit "$failed"
