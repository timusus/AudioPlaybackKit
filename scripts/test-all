#!/usr/bin/env bash
#
# The whole suite, conformance included (about 8 min, mostly PlaybackDecodeConformanceTests). For `land` and
# releases; iterate with `swift test --filter <Class>` or scripts/test-fast. Extra args pass through.
set -euo pipefail

cd "$(dirname "$0")/.." || exit 2
# CI runners have no `lease`; there the build runs unleased.
if command -v lease >/dev/null 2>&1; then LEASE=(lease --class build --); else LEASE=(); fi
exec ${LEASE[@]+"${LEASE[@]}"} swift test --parallel --num-workers 4 "$@"
