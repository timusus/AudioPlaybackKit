--swiftversion 5.9
--indent 4
--maxwidth none
--wraparguments preserve
--wrapparameters preserve
--wrapcollections preserve
--wrapconditions preserve
--wrapreturntype preserve
--wrapternary default
--self remove
--ifdef no-indent
--ranges preserve
--importgrouping testable-last
--commas inline
--stripunusedargs closure-only

--exclude .build,build,dist,Frameworks,.swiftpm,Sources/CFFmpeg,Sources/CStreamDecode

# Kept as written: these touch semantics, API surface or the repo's comment style.
--disable trailingCommas,wrapIfStatementBodies,wrapIfExpressionBodies,wrapFunctionBodies,wrapLoopBodies,numberFormatting,hoistTry,noForceUnwrapInTests,redundantSelf,blankLinesAtStartOfScope,blankLinesAtEndOfScope,docComments,redundantProperty,preferKeyPath,opaqueGenericParameters,redundantType,sortImports,trailingClosures,unusedArguments,wrapMultilineStatementBraces,hoistPatternLet,redundantMemberwiseInit,noExplicitOwnership,redundantInternal,redundantPublic,preferFinalClasses,redundantEquatable,sortDeclarations,organizeDeclarations,markTypes,extensionAccessControl,propertyTypes,redundantViewBuilder,wrapPropertyBodies,swiftTestingTestCaseNames,environmentEntry,sortSwitchCases,sortTypealiases,wrapSwitchCases,preferSwiftTesting
